# The web root of this application is the public/ directory.
# When the project folder itself is exposed by the web server (EasyPHP,
# shared hosting), send every request into public/ so that .env, root
# scripts, storage/ and vendor/ can never be requested directly.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite, refuse everything rather than expose the project.
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</IfModule>
